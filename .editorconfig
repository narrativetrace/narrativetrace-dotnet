root = true

[*.cs]
# Method length — fail build if any method exceeds 20 lines
dotnet_diagnostic.S138.severity = error

# Missing XML comments. Suppressed by default: tests, examples, benchmarks and
# the build project have no public API contract to document. Re-enabled for
# src/ below, where the XML-doc house conventions make /// a contract for AI
# consumers.
dotnet_diagnostic.CS1591.severity = none

# Allow empty types (abstract record bases, scaffold placeholders)
dotnet_diagnostic.S2094.severity = none

# Culture-invariant output is a cross-runtime contract:
# trace files must be byte-identical across machine locales (RENDER-17)
dotnet_diagnostic.CA1305.severity = error

# ── Shipped libraries ─────────────────────────────────────────────────────────
# Everything under src/ is packed and consumed by third parties, so every
# public type and member must document itself per the XML-doc house
# conventions. Kept at `warning` here so the list stays enumerable
# (`-p:CS1591AsError=false`); src/Directory.Build.props promotes it to an
# error for normal builds and CI.
[src/**/*.cs]
dotnet_diagnostic.CS1591.severity = warning

# ── Test naming ───────────────────────────────────────────────────────────────
# Underscore method names (Given_state_then_outcome) are this repository's
# deliberate test style, shared with every runtime. CA1707 firing on each of
# them buried a release-run failure under thousands of warnings
# (2026-09-06 publish run) — the rule simply does not apply to tests.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
