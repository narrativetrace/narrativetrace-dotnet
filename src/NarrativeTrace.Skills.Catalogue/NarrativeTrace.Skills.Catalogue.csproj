<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>NarrativeTrace.Skills</RootNamespace>
    <!-- Authoring tooling, not a product surface: the typed skill catalogue and its renderers
         generate .claude/skills/**/SKILL.md, .agents/skills/**/SKILL.md and the AGENTS.md managed
         section as build output (see skills-devtool's "render" verb, Phase 3 Q3). Renamed from
         NarrativeTrace.Skills (Phase 3 milestone 1) to free that coordinate for the published,
         resources-only carrier package — this project itself is never published; it mirrors the
         golden TypeScript source's packages/skills-catalogue, an unpublished workspace package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The one dependency this package carries, and deliberately so: SnippetResolver needs the
         exact same license-header-stripping logic build/SnippetCheckSupport.cs needs for the
         documentation snippets (a rendered SKILL.md page embeds a real source file verbatim too,
         and hits the identical publish-time-header drift) — NarrativeTrace.Core is the shared,
         dependency-free home for it, never a second implementation on either side. -->
    <ProjectReference Include="../NarrativeTrace.Core/NarrativeTrace.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NarrativeTrace.Skills.Catalogue.Tests" />
  </ItemGroup>
</Project>
