<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Referencing Runtime rather than Core directly: Runtime already carries
      Core as a package dependency (it needs the capture engine's model
      types), so this project reference flows through to the packed nuspec
      as a NarrativeTrace.Runtime dependency, which pulls Core with it. One
      `dotnet add package NarrativeTrace.Proxy` therefore restores all three
      packages the 60-second tutorial needs, instead of requiring three
      separate `dotnet add package` invocations. Compilation sees Core's
      types the same way either way (project references resolve
      transitively), so this is a packaging-graph change only — no source
      in this project touches a Runtime type.
    -->
    <ProjectReference Include="../NarrativeTrace.Runtime/NarrativeTrace.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NarrativeTrace.Proxy.Tests" />
    <!--
      NarrationResolver.Resolve is the one seam that takes a template string at
      runtime rather than as a compile-time [Narrated("...")] attribute
      constant, which is what the security fuzz suite's corpus-driven template
      cases need (a C# attribute argument cannot be a runtime JSON value). See
      TemplateRedactionPropertyTest.
    -->
    <InternalsVisibleTo Include="NarrativeTrace.SecurityTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.DispatchProxy" Version="4.8.2" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>
</Project>
