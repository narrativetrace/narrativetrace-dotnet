<?xml version="1.0" encoding="utf-8"?>
<!-- contract-probe's own package sources — deliberately independent of any repo-level
     NuGet.config (there is none today; this file is the guarantee, not an accident of absence).
     <clear/> then exactly one source: nuget.org. Never a local feed, never mavenLocal-equivalent,
     never this checkout's own artifacts/ output — a claim documentation/contract.yaml makes is
     proved against what a real consumer would actually download (docs-vs-published-gate §2/§5.1
     ruling 2). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
